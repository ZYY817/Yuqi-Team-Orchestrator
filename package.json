{
  "name": "yuqi-team-orchestrator",
  "description": "Event-sourced Cordis service for one-controller, continuable-child orchestration in DeepSeek Harness",
  "version": "0.0.1",
  "keywords": [
    "deepseek-harness",
    "multi-agent",
    "orchestration",
    "subagent",
    "cordis"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "yuqi-team-install-preset": "scripts/install-preset.mjs",
    "yuqi-team-check-host": "scripts/check-host-compatibility.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.cjs"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.cjs",
    "lib/client.cjs.map",
    "lib/agent.js",
    "lib/agent.d.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.js.map",
    "scripts/install-preset.mjs",
    "scripts/check-host-compatibility.mjs",
    "cordis.patch.yml",
    "presets/yuqi-team/preset.yml",
    "presets/yuqi-team/agent.cordis.yml",
    "docs/FEATURES.md",
    "docs/FEATURES.zh-CN.md",
    "docs/PROJECT_OVERVIEW.zh-CN.md",
    "docs/USER_GUIDE.md",
    "docs/USER_GUIDE.zh-CN.md"
  ],
  "dsh": {
    "compatibility": {
      "peerRangeMeaning": "api-baseline-only",
      "requiredSessionContract": "public-storage-domain-or-native-ignorable-replay",
      "verifiedOfficialRelease": null,
      "verifiedSidecarStorageRelease": "0.1.2-rc.1",
      "storageWriterScope": "single-host-process-per-storage-directory",
      "preflight": "scripts/check-host-compatibility.mjs"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:harness": "pnpm run build && node tests/integration/harness-public-api.mjs",
    "test:bundle": "pnpm run build && node tests/integration/package-bundle.mjs",
    "test:profile-install": "pnpm run build && node tests/integration/profile-install.mjs",
    "test:preset-install": "node tests/integration/preset-install.mjs",
    "test:preset-matrix": "node tests/integration/preset-compatibility-matrix.mjs",
    "test:host-compatibility": "node scripts/check-host-compatibility.mjs",
    "test:tarball-install": "pnpm run build && node tests/integration/tarball-install.mjs",
    "test:e2e:fixture": "node tests/e2e/fixture-provider.smoke.mjs",
    "test:e2e:host": "node tests/e2e/real-host.runner.mjs",
    "preset:install": "node scripts/install-preset.mjs",
    "build": "tsdown",
    "publint": "publint",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run test:bundle && pnpm run test:preset-install && pnpm run test:profile-install && pnpm run test:tarball-install && pnpm run test:harness && pnpm run publint"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "publint": "0.3.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
